# Environment Configuration for MINO Platform
# Copy this file to .env and adjust values for local development or production.

# Application Settings
ENVIRONMENT=development
DEBUG=True
APP_NAME="MINO Deepfake Forensics"
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Server
HOST=127.0.0.1
PORT=8000
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# Database (PostgreSQL / SQLite for local development)
DATABASE_URL=sqlite:///./mino.db
# DATABASE_URL=postgresql://mino_user:mino_pass@localhost:5432/mino_db

# Redis & Background Tasks
REDIS_URL=redis://localhost:6379/0
TASK_QUEUE_NAME=mino_analysis_queue
# Set to True to execute background tasks asynchronously via in-process threads or worker
WORKER_MODE=inprocess

# Storage Configuration (local or s3)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/storage
LOCAL_UPLOAD_DIR=./data/uploads

# Admin Initial Seed Credentials
FIRST_SUPERUSER_EMAIL=admin@mino.local
FIRST_SUPERUSER_PASSWORD=AdminSecurePassword123!
FIRST_SUPERUSER_NAME="System Administrator"

# Media Limits
MAX_UPLOAD_SIZE_BYTES=104857600  # 100 MB
MAX_VIDEO_DURATION_SECONDS=180   # 3 minutes
ALLOWED_IMAGE_EXTENSIONS=["jpg","jpeg","png","webp"]
ALLOWED_VIDEO_EXTENSIONS=["mp4","mov","webm"]

# ML Models & Device
DEVICE=cpu
DEFAULT_MODEL_NAME=mino-efficientnet-b0
DEFAULT_MODEL_VERSION=v1.0.0
MODEL_CHECKPOINT_PATH=./data/models/mino_baseline_v1.pt
VIDEO_SAMPLE_FRAMES=16
SCORE_THRESHOLD_LOW=0.35
SCORE_THRESHOLD_HIGH=0.65
